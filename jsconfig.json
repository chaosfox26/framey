{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": []
  },
  "include": [
    "*.js",
    "compat/*.js",
    "examples/*/*.js",
    "types/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "tests",
    ".venv",
    "graphify-out"
  ],
  "typeAcquisition": {
    "enable": false
  }
}
